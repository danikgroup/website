---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Icon from "../components/Icon.astro";
import site from "../data/site.json";
import { breadcrumbs } from "../utils.js";

const jsonLd = [breadcrumbs(Astro.site, [[site.name, "/"], ["تماس", "/contact/"]])];

const ways = [
  site.phone && { icon: "call", label: "تلفن", value: site.phone, link: `tel:${site.phone}`, ltr: true },
  site.email && { icon: "mail", label: "ایمیل", value: site.email, link: `mailto:${site.email}`, ltr: true },
  site.address && { icon: "pin", label: "نشانی", value: site.address },
].filter(Boolean);

// What happens after the first call, in order.
const steps = [
  { icon: "call", title: "یک تماس کوتاه", text: "بگویید مدرسه هستید یا آموزشگاه، چند دانش‌آموز دارید و الان حضور و غیاب و شهریه را با چه ابزاری پیش می‌برید." },
  { icon: "phone", title: "نسخهٔ نمایشی", text: "نرم‌افزار را با اطلاعات نمونه، از نگاه مدیر، معلم و ولی نشانتان می‌دهیم؛ با همان کارهایی که برایتان مهم است." },
  { icon: "server", title: "نصب و راه‌اندازی", text: "روی سرور شما نصب می‌شود، نام و لوگو و رنگ مجموعه تنظیم می‌شود، دانش‌آموزان از فایل وارد می‌شوند و برگهٔ ورود هر نفر چاپ می‌شود." },
];

const prepare = [
  "شمار دانش‌آموزان، کلاس‌ها و معلم‌ها",
  "روش فعلی ثبت حضور و غیاب، نمره و شهریه",
  "کارهایی که امروز بیشترین وقت را از دفتر می‌گیرند",
  "پرسش‌هایتان دربارهٔ سرور و نگهداری اطلاعات",
];
---
<Base title="تماس با ما" description={`راه‌های تماس با ${site.name} برای مشاوره و دیدن نسخهٔ نمایشی دانیک مدرسه و دانما.`} jsonLd={jsonLd}>
  <PageHeader title="تماس با ما" lead="برای دیدن نسخهٔ نمایشی، پرسیدن قیمت یا مشاوره دربارهٔ نرم‌افزار مدرسه یا آموزشگاه‌تان تماس بگیرید." />

  <section class="section">
    <div class="wrap">
      {ways.length > 0 ? (
        <ul class="ways">
          {ways.map((w) => (
            <li>
              <span class="disc"><Icon name={w.icon} size={28} /></span>
              <b>{w.label}</b>
              {w.link ? <a href={w.link} dir={w.ltr ? "ltr" : undefined}>{w.value}</a> : <span>{w.value}</span>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">اطلاعات تماس هنوز وارد نشده است.</p>
      )}

      <div class="next">
        <h2 id="next-title">بعد از تماس چه می‌شود؟</h2>
        <ol class="steps" aria-labelledby="next-title">
          {steps.map((s) => (
            <li>
              <span class="ring"><Icon name={s.icon} size={26} /></span>
              <b>{s.title}</b>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="prepare">
        <h2 id="prepare-title">برای جلسهٔ نمایش، این‌ها را آماده کنید</h2>
        <ul aria-labelledby="prepare-title">
          {prepare.map((item) => (
            <li><span class="tick"><Icon name="check" size={16} strokeWidth={2.6} /></span>{item}</li>
          ))}
        </ul>
      </div>

      {site.social.length > 0 && (
        <ul class="social">
          {site.social.map((s) => <li><a class="btn btn-blue" href={s.url} rel="me noopener">{s.name}</a></li>)}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 48px 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .ways li {
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .disc {
    display: grid;
    place-items: center;
    inline-size: 72px;
    block-size: 72px;
    margin-block-end: 10px;
    border-radius: 22px;
    background: var(--white);
    color: var(--blue);
    box-shadow: var(--shadow);
  }

  .ways b {
    color: var(--navy);
    font-size: 1.15rem;
  }

  .ways a {
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 64px 0 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    text-align: center;
  }

  .next,
  .prepare {
    margin-block-start: clamp(72px, 10vw, 120px);
    text-align: center;
  }

  /* The three steps after a call, numbered because they happen in this order. */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: grid;
    justify-items: center;
    gap: 10px;
    counter-increment: step;
  }

  .steps .ring {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    border: 1.5px solid var(--blue-2);
    border-radius: 50%;
    color: var(--navy);
  }

  .steps .ring::after {
    content: counter(step, persian);
    position: absolute;
    inset-block-start: -6px;
    inset-inline-end: -6px;
    display: grid;
    place-items: center;
    inline-size: 26px;
    block-size: 26px;
    border-radius: 50%;
    background: var(--blue-grad);
    color: var(--white);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .steps b {
    color: var(--navy);
    font-size: 1.15rem;
  }

  .steps p {
    max-inline-size: 34ch;
  }

  .prepare ul {
    display: grid;
    gap: 14px;
    inline-size: fit-content;
    margin: 32px auto 0;
    padding: 32px clamp(24px, 4vw, 48px);
    border-radius: 28px;
    background: var(--grey);
    box-shadow: inset 0 1px 0 var(--white);
    list-style: none;
    color: var(--navy);
    text-align: start;
  }

  .prepare li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .tick {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 26px;
    block-size: 26px;
    margin-block-start: 3px;
    border-radius: 50%;
    background: var(--green-grad);
  }
</style>
