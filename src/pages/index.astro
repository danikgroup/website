---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Device from "../components/Device.astro";
import Screen from "../components/Screen.astro";
import Icon from "../components/Icon.astro";
import DemoBand from "../components/DemoBand.astro";
import site from "../data/site.json";
import { href, faDate, products, posts } from "../utils.js";
import { screenLabels, phoneLabel } from "../screens.js";
import ProductScreen from "../components/ProductScreen.astro";

const productList = await products();
const latest = (await posts()).slice(0, 3);

// Facts for the split sections: counts from the products themselves.
const facts = {
  "danik-school": [["۱۲", "پایهٔ تحصیلی"], ["۷", "نقش کاربری"], ["۳", "نوبت ارزشیابی"]],
  danma: [["۱۲", "بخش اختیاری"], ["۲", "نوع کلاس"], ["۱", "پنل برای همه"]],
};

const why = [
  { icon: "server", title: "روی سرور خودتان", text: "اطلاعات دانش‌آموزان و خانواده‌ها روی سرور خود مجموعه می‌ماند و هر شب از آن پشتیبان گرفته می‌شود." },
  { icon: "calendar", title: "فارسی و شمسی", text: "رابط راست‌به‌چپ، تاریخ شمسی و ارقام فارسی؛ تعطیلات رسمی در برنامهٔ کلاس‌ها حساب می‌شود." },
  { icon: "phone", title: "پنل روی گوشی", text: "اولیا، دانش‌آموزان و معلمان با گوشی وارد می‌شوند و پنل مثل اپلیکیشن روی گوشی نصب می‌شود." },
  { icon: "bell", title: "پیامک و اعلان", text: "غیبت، قسط، کارنامه و آزمون با اعلان پنل، پیامک و اعلان مرورگر به خانواده خبر داده می‌شود." },
];

const steps = [
  { icon: "message", title: "گفت‌وگو و دمو", text: "نیازتان را می‌شنویم و نرم‌افزار را با اطلاعات نمونه نشانتان می‌دهیم." },
  { icon: "server", title: "نصب روی سرور شما", text: "نصب روی سرور مجموعه و فعال شدن بخش‌هایی که انتخاب کرده‌اید." },
  { icon: "settings", title: "تنظیمات اولیه", text: "نام، لوگو و رنگ مجموعه، سال تحصیلی و زنگ‌ها در صفحهٔ راه‌اندازی." },
  { icon: "import", title: "ورود دانش‌آموزان از فایل", text: "فهرست دانش‌آموزان از فایل CSV وارد می‌شود و برگهٔ ورود هر نفر چاپ می‌شود." },
  { icon: "timetable", title: "برنامهٔ هفتگی", text: "با چیدن برنامهٔ هفتگی، جلسه‌های هر کلاس خودکار ساخته می‌شوند." },
  { icon: "backup", title: "پشتیبان‌گیری شبانه", text: "هر شب نسخهٔ پشتیبان گرفته می‌شود تا اطلاعات از دست نرود." },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: new URL(href("/"), Astro.site).href,
    inLanguage: "fa",
  },
];
---
<Base title={site.name} description={site.description} jsonLd={jsonLd}>
  <Hero
    small="نرم‌افزار مدیریت"
    big="مدرسه و آموزشگاه"
    lead="دانیک مدرسه برای مدرسه‌های ابتدایی تا متوسطه و دانما برای آموزشگاه‌ها: حضور و غیاب، نمره، شهریه و ارتباط با اولیا در یک پنل فارسی."
    screen="rollcall"
    screenLabel={screenLabels.rollcall}
    icons={["money", "report", "exam", "message", "attendance", "timetable", "bell", "graduation"]}
    next="#why"
  />

  <section id="why" class="section">
    <div class="wrap">
      <div class="intro">
        <h2>ساخته‌شده برای مدرسه و آموزشگاه ایرانی</h2>
        <p>کارهای روزمرهٔ مدیر، دفتر، معلم و خانواده از یک پنل انجام می‌شود؛ هر کس فقط بخش مربوط به خودش را می‌بیند.</p>
      </div>
      <Features items={why} />
    </div>
  </section>

  {productList.map((product, n) => {
    const productFacts = facts[product.id] ?? [];
    return (
      <section class:list={["section", "split", { flip: n % 2 }]} aria-labelledby={`p-${product.id}`}>
        <div class="wrap split-grid">
          <div class="split-text">
            <h2 id={`p-${product.id}`}>
              <span class="kicker">{product.data.category}</span>
              {product.data.name}
            </h2>
            <p>{product.data.description}</p>
            <ul class="points">
              {product.data.features.slice(0, 2).map((f) => (
                <li>
                  <span class="ring"><Icon name={f.icon} size={26} /></span>
                  <span><b>{f.title}</b>{f.text}</span>
                </li>
              ))}
            </ul>
            {productFacts.length > 0 && (
              <dl class="facts" data-live>
                {productFacts.map(([num, label]) => (
                  <div><dt>{label}</dt><dd data-count>{num}</dd></div>
                ))}
              </dl>
            )}
            <a class="btn btn-blue" href={href(`/products/${product.id}/`)}>معرفی کامل {product.data.name}</a>
          </div>
          <div class="split-art">
            <Device label={phoneLabel(product.data)}><ProductScreen data={product.data} /></Device>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section process" aria-labelledby="process-title">
    <div class="wrap">
      <div class="intro">
        <h2 id="process-title">از اولین تماس تا اولین روز کلاس</h2>
        <p>راه‌اندازی هر دو نرم‌افزار همین شش قدم است.</p>
      </div>
      <div class="process-grid">
        <ol class="steps" data-live>
          {steps.slice(0, 3).map((s, i) => (
            <li style={`--i: ${i}`}><span class="ring"><Icon name={s.icon} size={26} /></span><span><b>{s.title}</b>{s.text}</span></li>
          ))}
        </ol>
        <Device class="process-phone" label={screenLabels.timetable}>
          <Screen kind="timetable" />
        </Device>
        <ol class="steps" start="4" data-live>
          {steps.slice(3).map((s, i) => (
            <li style={`--i: ${i + 3}`}><span class="ring"><Icon name={s.icon} size={26} /></span><span><b>{s.title}</b>{s.text}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {site.testimonials?.length > 0 && (
    <section class="section" aria-labelledby="voices">
      <div class="wrap">
        <div class="intro"><h2 id="voices">نظر مدیران</h2></div>
        <ul class="voices">
          {site.testimonials.map((t) => (
            <li>
              <span class="initial" aria-hidden="true">{t.name[0]}</span>
              <b>{t.name}</b>
              <small>{t.role}</small>
              <blockquote>{t.text}</blockquote>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="chooser" aria-labelledby="chooser-title">
    <div class="wrap chooser-grid">
      <div class="chooser-text">
        <h2 id="chooser-title">مدرسه دارید یا آموزشگاه؟</h2>
        <p>
          دو نرم‌افزار جدا برای دو کار متفاوت. مدرسه با سال تحصیلی، پایه، کارنامه و آیین‌نامهٔ ارتقا کار می‌کند؛
          آموزشگاه با دوره، کلاس گروهی و خصوصی، شهریه و فروش.
        </p>
      </div>
      <ul class="choices">
        {productList.map((p) => (
          <li>
            <a href={href(`/products/${p.id}/`)}>
              <Icon name={p.data.features[0]?.icon ?? "module"} size={40} strokeWidth={1.4} />
              <b>{p.data.name}</b>
              <span>{p.data.category}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="section" aria-labelledby="latest">
      <div class="wrap">
        <div class="intro"><h2 id="latest">تازه‌های وبلاگ</h2></div>
        <ul class="posts">
          {latest.map((post) => (
            <li>
              <time datetime={post.data.date.toISOString()}>{faDate(post.data.date)}</time>
              <h3><a href={href(`/blog/${post.id}/`)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <DemoBand />
</Base>

<style>
  .kicker {
    display: block;
    color: var(--muted);
    font-size: 1.05rem;
    font-weight: 500;
  }

  /* Product split: text + facts beside a phone; every other one mirrored. The phones start
     off to the side before swinging in, so the section clips sideways overflow. */
  .split {
    overflow-x: clip;
  }

  .split-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(40px, 8vw, 120px);
  }

  .flip .split-text {
    order: 2;
  }

  .split-text {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .split-text > p {
    max-inline-size: 60ch;
  }

  .split-art {
    display: grid;
    place-items: center;
    padding-block: 40px;
    background: radial-gradient(circle closest-side, var(--grey) 0 92%, transparent 92.5%);
  }

  .points,
  .steps {
    display: grid;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .points li,
  .steps li {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .points li > span:last-child,
  .steps li > span:last-child {
    display: grid;
    gap: 2px;
    max-inline-size: 42ch;
  }

  .points b,
  .steps b {
    color: var(--navy);
    font-size: 1.05rem;
  }

  .ring {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 60px;
    block-size: 60px;
    border: 1.5px solid var(--blue-2);
    border-radius: 50%;
    color: var(--navy);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    inline-size: 100%;
    margin: 0;
    padding: clamp(24px, 3vw, 36px);
    border-radius: 40px;
    background: var(--green-grad);
    box-shadow: 0 20px 45px rgba(7, 119, 86, 0.22);
    text-align: center;
    color: var(--navy);
  }

  .facts div {
    display: flex;
    flex-direction: column-reverse;
  }

  .facts dd {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.3;
  }

  .facts dt {
    font-size: 0.9rem;
  }

  /* Product phones swing in from their own side; the screen then acts out its feature. */
  :global(.js) .split-art :global(.device) {
    animation: split-in 0.9s cubic-bezier(0.2, 0.9, 0.25, 1) both paused;
  }

  .split-art :global(.device.is-live) {
    animation-play-state: running;
  }

  @keyframes split-in {
    from {
      opacity: 0;
      transform: translateX(-60px) rotate(-8deg);
    }
  }

  .flip .split-art :global(.device) {
    animation-name: split-in-flip;
  }

  @keyframes split-in-flip {
    from {
      opacity: 0;
      transform: translateX(60px) rotate(8deg);
    }
  }

  /* Setup steps light up in order, 1 to 6, across both columns. */
  :global(.js) .steps .ring {
    animation: step-light 0.9s ease-in-out both paused;
    animation-delay: calc(0.2s + var(--i) * 0.3s);
  }

  .steps:global(.is-live) .ring {
    animation-play-state: running;
  }

  @keyframes step-light {
    45% {
      border-color: transparent;
      background: var(--blue-grad);
      color: var(--white);
      scale: 1.12;
      box-shadow: var(--shadow-strong);
    }
  }

  /* Process: steps on both sides of a phone, under a wide grey arc. */
  .process {
    background: radial-gradient(ellipse 90% 520px at 50% 0, var(--grey) 99.5%, var(--white) 100%);
  }

  .process-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .process-phone {
    --device-w: 250px;
  }

  /* Template list: one section of three quoted voices. */
  .voices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .voices li {
    display: grid;
    justify-items: center;
    gap: 4px;
  }

  .initial {
    display: grid;
    place-items: center;
    inline-size: 96px;
    block-size: 96px;
    margin-block-end: 16px;
    border-radius: 50%;
    background: var(--blue-grad);
    color: var(--white);
    font-size: 2rem;
    font-weight: 800;
    box-shadow: var(--shadow);
  }

  .voices b {
    color: var(--navy);
    font-size: 1.15rem;
  }

  .voices blockquote {
    margin: 12px 0 0;
    max-inline-size: 36ch;
  }

  /* Blue band: where the template shows partner logos, the two products. */
  .chooser {
    padding-block: clamp(72px, 9vw, 120px);
    background:
      radial-gradient(circle at 15% 120%, rgba(255, 255, 255, 0.09) 0 38%, transparent 38.2%),
      radial-gradient(circle at 0% 120%, rgba(255, 255, 255, 0.07) 0 55%, transparent 55.2%),
      var(--blue-grad);
    color: var(--white);
  }

  .chooser-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }

  .chooser h2 {
    color: var(--white);
  }

  .chooser-text p {
    margin-block-start: 16px;
    max-inline-size: 48ch;
  }

  .choices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .choices a {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 32px 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 28px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
    text-align: center;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }

  .choices a:hover {
    background: rgba(255, 255, 255, 0.16);
    transform: translateY(-3px);
  }

  .choices b {
    font-size: 1.35rem;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .posts time {
    font-size: 0.9rem;
  }

  .posts h3 a {
    color: var(--navy);
    text-decoration: none;
  }

  .posts h3 a:hover {
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .split-grid,
    .chooser-grid {
      grid-template-columns: 1fr;
    }

    .flip .split-text {
      order: 0;
    }

    .process-grid {
      grid-template-columns: 1fr;
    }

    .process-phone {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .facts {
      border-radius: 28px;
      gap: 8px;
    }

    .choices {
      grid-template-columns: 1fr;
    }
  }
</style>
