---
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import Features from "../../components/Features.astro";
import DemoBand from "../../components/DemoBand.astro";
import Compare from "../../components/Compare.astro";
import Timeline from "../../components/Timeline.astro";
import Trust from "../../components/Trust.astro";
import Faq from "../../components/Faq.astro";
import ProductCards from "../../components/ProductCards.astro";
import Icon from "../../components/Icon.astro";
import site from "../../data/site.json";
import { products, breadcrumbs, faqLd } from "../../utils.js";
import { phoneLabel } from "../../screens.js";
import ProductScreen from "../../components/ProductScreen.astro";

export async function getStaticPaths() {
  return (await products()).map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const shot = data.screenshot && (await getImage({ src: data.screenshot, width: 660, format: "jpg" }));


const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: data.name,
    ...(data.alternateName && { alternateName: data.alternateName }),
    description: data.description,
    applicationCategory: "BusinessApplication",
    applicationSubCategory: data.category,
    operatingSystem: "Web",
    inLanguage: "fa",
    url: new URL(Astro.url.pathname, Astro.site).href,
    featureList: data.features.map((f) => f.title),
    ...(shot && { screenshot: new URL(shot.src, Astro.site).href }),
    publisher: { "@type": "Organization", name: site.name },
  },
  breadcrumbs(Astro.site, [[site.name, "/"], [data.name, `/products/${product.id}/`]]),
  faqLd(data.faq),
].filter(Boolean);
---
<Base title={data.title} description={data.description} image={data.image} imageAlt={data.imageAlt} jsonLd={jsonLd}>
  <Hero
    small={data.category}
    big={data.name}
    lead={data.tagline}
    screen={data.screen}
    screenLabel={phoneLabel(data)}
    icons={data.features.map((f) => f.icon)}
    next="#about"
  >
    <ProductScreen data={data} eager />
  </Hero>

  <section id="about" class="section">
    <div class="prose">
      <Content />
    </div>
    {data.image && (
      <Image class="shot wrap" src={data.image} alt={data.imageAlt ?? ""} widths={[640, 1200]} sizes="(max-width: 1200px) 100vw, 1200px" />
    )}
  </section>

  {data.pains.length > 0 && (
    <section class="section grey-band" aria-labelledby="pains">
      <div class="wrap">
        <div class="intro">
          <h2 id="pains">کارهایی که {data.name} از دوشتان برمی‌دارد</h2>
          <p>همان کارهای هر روز، بدون دفتر و اکسل و تماس‌های تکراری.</p>
        </div>
        <Compare rows={data.pains} before="امروز" after={`با ${data.name}`} caption={`کارهای روزانه، امروز و با ${data.name}`} />
      </div>
    </section>
  )}

  {data.features.length > 0 && (
    <section class="section" aria-labelledby="features">
      <div class="wrap">
        <div class="intro">
          <h2 id="features">امکانات {data.name}</h2>
          <p>هر بخش برای یک کار واقعی مجموعه ساخته شده و با بقیه یکپارچه است؛ اطلاعات یک بار وارد می‌شود.</p>
        </div>
        <Features items={data.features} />
      </div>
    </section>
  )}

  {data.day.length > 0 && (
    <section class="section day" aria-labelledby="day">
      <div class="wrap">
        <div class="intro">
          <h2 id="day">یک روز با {data.name}</h2>
          <p>از صبح تا نیمه‌شب؛ کارهایی که خودشان انجام می‌شوند یا با یک لمس روی گوشی.</p>
        </div>
        <Timeline items={data.day} />
      </div>
    </section>
  )}

  <Trust />

  {data.fit.length > 0 && (
    <section class="section" aria-labelledby="fit">
      <div class="wrap fit-grid">
        <div>
          <h2 id="fit">{data.name} مناسب شماست اگر…</h2>
          <ul class="fit">
            {data.fit.map((item) => (
              <li><span class="tick"><Icon name="check" size={16} strokeWidth={2.6} /></span>{item}</li>
            ))}
          </ul>
        </div>
        <aside aria-labelledby="other">
          <h3 id="other">دنبال چیز دیگری هستید؟</h3>
          <ProductCards except={product.id} />
        </aside>
      </div>
    </section>
  )}

  <Faq items={data.faq} />

  <DemoBand />
</Base>

<style>
  #about {
    padding-block-end: 0;
  }

  .prose {
    padding-inline: var(--gutter);
    text-align: center;
    font-size: 1.15rem;
  }

  .shot {
    margin-block-start: 64px;
    border-radius: 28px;
    box-shadow: var(--shadow);
  }

  .day {
    padding-block-end: calc(var(--section) - 36px);
  }

  .fit-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .fit {
    display: grid;
    gap: 16px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    color: var(--navy);
    font-size: 1.1rem;
  }

  .fit li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .tick {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 28px;
    block-size: 28px;
    margin-block-start: 3px;
    border-radius: 50%;
    background: var(--green-grad);
    box-shadow: var(--rim);
  }

  aside h3 {
    margin-block-end: 20px;
  }

  @media (max-width: 900px) {
    .fit-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
