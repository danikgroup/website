---
// Grey opener for inner pages (blog, contact, 404): the hero's background without the phone.
const { title, lead } = Astro.props;
---
<section class="page-header">
  <div class="wrap">
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
  </div>
</section>

<style>
  /* Same squared paper as the home hero, fading out from behind the title. */
  .page-header {
    position: relative;
    isolation: isolate;
    padding-block: clamp(150px, 18vw, 200px) clamp(72px, 9vw, 112px);
    background: radial-gradient(ellipse 120% 100% at 50% 0, var(--grey) 99.6%, var(--white) 100%);
    text-align: center;
  }

  .page-header::before {
    content: "";
    position: absolute;
    inset: 40px 0 0;
    background: var(--paper);
    mask-image: radial-gradient(ellipse 45% 70% at 50% 45%, #000, transparent);
    z-index: -1;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
  }

  p {
    max-inline-size: 36rem;
    margin: 16px auto 0;
  }
</style>
