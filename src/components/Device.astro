---
// Phone frame for the screens drawn by Screen.astro. `label` says what it shows.
// `...rest` carries the parent's scoped-style attribute, so `class` from a parent's <style> applies.
const { label, class: className, ...rest } = Astro.props;
---
<div class:list={["device", className]} role="img" aria-label={label} data-live {...rest}>
  <div class="screen">
    <div class="status" aria-hidden="true"><span>۹:۴۱</span><i></i></div>
    <slot />
  </div>
</div>

<style>
  .device {
    inline-size: var(--device-w, 270px);
    aspect-ratio: 9 / 18.5;
    padding: 10px;
    border-radius: 44px;
    background: var(--white);
    box-shadow:
      0 30px 60px rgba(7, 65, 154, 0.22),
      inset 0 0 0 1px var(--line);
  }

  .screen {
    position: relative;
    block-size: 100%;
    overflow: hidden;
    border-radius: 34px;
    background: #f6f8fc;
    font-size: 11px;
    line-height: 1.6;
    color: var(--navy);
  }

  .status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 22px 4px;
    font-weight: 700;
    font-size: 10px;
  }

  .status i {
    inline-size: 64px;
    block-size: 16px;
    border-radius: 10px;
    background: var(--navy);
  }
</style>
