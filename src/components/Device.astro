---
// Phone frame for the screens drawn by Screen.astro. `label` says what it shows.
// `...rest` carries the parent's scoped-style attribute, so `class` from a parent's <style> applies.
const { label, class: className, ...rest } = Astro.props;
---
<div class:list={["device", className]} role="img" aria-label={label} data-live {...rest}>
  <div class="screen">
    <div class="status" aria-hidden="true"><span>۹:۴۱</span><i></i></div>
    <slot />
  </div>
</div>

<style>
  .device {
    inline-size: var(--device-w, 270px);
    aspect-ratio: 9 / 18.5;
    padding: 10px;
    border-radius: 44px;
    /* Bezel lit from above: bright top edge, a shade darker toward the bottom, then a tight
       contact shadow under a long soft one. */
    background: linear-gradient(170deg, var(--white) 40%, #e9edf5);
    box-shadow:
      inset 0 0 0 1px var(--line),
      inset 0 2px 0 var(--white),
      0 2px 4px rgba(20, 18, 43, 0.06),
      0 24px 48px -12px rgba(7, 65, 154, 0.22),
      0 64px 100px -32px rgba(7, 65, 154, 0.28);
  }

  /* Inner edge of the glass, so the screen sits in the frame instead of on it. */
  .screen {
    box-shadow: inset 0 0 0 1px rgba(35, 32, 63, 0.06);
  }

  .screen {
    position: relative;
    block-size: 100%;
    overflow: hidden;
    border-radius: 34px;
    background: #f6f8fc;
    font-size: 11px;
    line-height: 1.6;
    color: var(--navy);
  }

  .status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 22px 4px;
    font-weight: 700;
    font-size: 10px;
  }

  .status i {
    inline-size: 64px;
    block-size: 16px;
    border-radius: 10px;
    background: var(--navy);
  }
</style>
