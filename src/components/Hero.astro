---
// Template hero: two-line headline on grey, a phone rising out of green rings, icon tiles on an arc.
// Load sequence: headline rises, rings grow, phone rises out of them, tiles burst from the rings and
// their icons draw themselves; then the tiles float and lean toward the pointer.
import Device from "./Device.astro";
import Screen from "./Screen.astro";
import Icon from "./Icon.astro";

const { small, big, lead, screen, screenLabel, icons = [], next = "#next" } = Astro.props;

// Tiles orbit the rings' centre just outside them: half on each side, 18°–52° from vertical,
// which keeps them clear of the phone and above the stage's bottom edge.
const tiles = icons.slice(0, 8);
const side = Math.ceil(tiles.length / 2);
const angle = (i) => {
  const j = i % side;
  const deg = side < 2 ? 35 : 52 - (34 * j) / (side - 1);
  return i < side ? -deg : deg;
};
---
<section class="hero" data-parallax>
  <div class="wrap text">
    <h1><span class="line small">{small}</span> <span class="line big">{big}</span></h1>
    {lead && <p>{lead}</p>}
  </div>

  <div class="stage">
    <ul class="tiles" aria-hidden="true">
      {tiles.map((name, i) => (
        <li style={`--a: ${angle(i)}deg; --i: ${i}; --depth: ${i % 2 ? 1 : 0.55}`}>
          <span class="tile" data-draw><Icon name={name} size={30} /></span>
        </li>
      ))}
    </ul>
    <div class="lift"><Device class="phone" label={screenLabel}><slot><Screen kind={screen} /></slot></Device></div>
    <div class="rings" aria-hidden="true"></div>
  </div>

  <a class="next" href={next} aria-label="رفتن به بخش بعد"><Icon name="arrowDown" size={22} strokeWidth={2.4} /></a>
</section>

<style>
  .hero {
    position: relative;
    padding-block-start: clamp(130px, 16vw, 170px);
    background: radial-gradient(ellipse 130% 74% at 50% 0, var(--grey) 99.6%, var(--white) 100%);
    text-align: center;
    isolation: isolate;
  }

  /* Squared exercise-book paper behind the headline (the template's dot texture, made the
     school's own). Two sheets, fine and coarse, slide at different rates with the pointer,
     so the page reads as layers, not a flat print. */
  .hero::before,
  .hero::after {
    content: "";
    position: absolute;
    inset-block-start: 40px;
    left: 50%;
    inline-size: min(1100px, 100vw);
    block-size: 640px;
    background: var(--paper);
    mask-image: radial-gradient(closest-side, #000 30%, transparent);
    translate: calc(-50% + var(--px, 0) * -6px) calc(var(--py, 0) * -4px);
    transition: translate 0.8s ease-out;
    z-index: -1;
  }

  .hero::after {
    background: var(--paper-major);
    translate: calc(-50% + var(--px, 0) * -18px) calc(var(--py, 0) * -12px);
  }

  h1 {
    display: grid;
    gap: 4px;
  }

  .small {
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    font-weight: 400;
  }

  .big {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .text p {
    max-inline-size: 36rem;
    margin: 20px auto 0;
    font-size: 1.0625rem;
  }

  .stage {
    /* Rings are a half-disc --ring-w wide, pushed 55% below the stage; their centre is
       0.275 × --ring-w under the stage's bottom edge, and the tiles orbit that point. */
    --ring-w: min(1100px, 100vw);
    position: relative;
    display: grid;
    justify-items: center;
    block-size: clamp(380px, 46vw, 560px);
    margin-block-start: 48px;
    overflow: clip;
  }

  .phone {
    --device-w: clamp(220px, 24vw, 280px);
    --base: 1.7s; /* the roll call starts once the phone has risen */
  }

  /* The phone turns in 3D toward the pointer; a glare slides across its glass as it does.
     .lift carries the pose so the phone's own rise animation stays independent. */
  .lift {
    position: relative;
    z-index: 1;
    transform: perspective(1100px) translate(calc(var(--px, 0) * -6px), calc(var(--py, 0) * -4px))
      rotateY(calc(var(--px, 0) * 9deg)) rotateX(calc(var(--py, 0) * -5deg));
    transition: transform 0.7s ease-out;
  }

  /* Light the screen throws onto the paper behind it. */
  .lift::before {
    content: "";
    position: absolute;
    inset: 4% -45% 20%;
    background: radial-gradient(closest-side, rgba(20, 105, 235, 0.2), transparent);
    z-index: -1;
  }

  .lift::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 44px;
    /* A vertical streak in an image 3× the phone's width: position 0% puts it past the right
       edge, 80% just past the left. It rests there and comes onto the glass as the pointer
       moves left. */
    background: linear-gradient(90deg, transparent 43%, rgba(255, 255, 255, 0.32) 48%, transparent 53%) 0 0 / 300% 100%;
    background-position-x: calc(80% + var(--px, 0) * 20%);
    pointer-events: none;
    transition: background-position 0.7s ease-out;
    animation: hero-glare 1.3s cubic-bezier(0.4, 0, 0.2, 1) 1.6s backwards;
  }

  @keyframes hero-glare {
    from {
      background-position-x: 0%;
    }

    to {
      background-position-x: 80%;
    }
  }

  /* Rings as a lit stepped dome: deeper greens, light from above, a bright rim on each step,
     and a glow the dome casts up onto the grey. */
  .rings {
    position: absolute;
    inset-block-end: 0;
    inline-size: var(--ring-w);
    aspect-ratio: 2 / 1;
    border-radius: 100vw 100vw 0 0;
    background:
      radial-gradient(
        circle farthest-side at 50% 100%,
        transparent 54.6%,
        rgba(255, 255, 255, 0.45) 55%,
        transparent 55.5%,
        transparent 69.6%,
        rgba(255, 255, 255, 0.4) 70%,
        transparent 70.5%,
        transparent 84.6%,
        rgba(255, 255, 255, 0.4) 85%,
        transparent 85.5%,
        transparent 99.2%,
        rgba(255, 255, 255, 0.7) 99.7%
      ),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.16), transparent 22%, rgba(4, 48, 36, 0.3) 45%),
      var(--grain),
      radial-gradient(
        circle farthest-side at 50% 100%,
        #077a59 0 55%,
        #0b956d 55% 70%,
        #0fb281 70% 85%,
        #16cd96 85% 100%
      );
    box-shadow: 0 -12px 90px -36px rgba(20, 226, 164, 0.45);
    left: 50%;
    translate: -50% 55%;
    transform-origin: 50% 100%;
    z-index: 2;
  }

  .tiles {
    --r: calc(var(--ring-w) / 2 + 60px);
    position: absolute;
    inset-block-end: calc(-0.275 * var(--ring-w));
    left: 50%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* li = place on the orbit (transform) + pointer lean (translate); .tile = float + look. */
  .tiles li {
    position: absolute;
    inline-size: 72px;
    block-size: 72px;
    margin: -36px 0 0 -36px;
    transform: rotate(var(--a)) translateY(calc(-1 * var(--r))) rotate(calc(var(--a) * -0.6));
    translate: calc(var(--px, 0) * var(--depth) * 16px) calc(var(--py, 0) * var(--depth) * 10px);
    transition: translate 0.5s ease-out;
  }

  /* Glass tiles with depth of field: near ones (even) sit in front of the dome, crisp;
     far ones sit behind the phone and dome, smaller and slightly out of focus. */
  .tiles li:nth-child(odd) {
    z-index: 1;
  }

  .tiles li:nth-child(even) {
    z-index: 3;
  }

  .tile {
    display: grid;
    place-items: center;
    block-size: 100%;
    border: 1px solid rgba(255, 255, 255, 0.9);
    border-radius: 20px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.72));
    backdrop-filter: blur(10px) saturate(1.4);
    color: var(--blue);
    box-shadow: var(--rim), inset 0 -2px 0 rgba(7, 65, 154, 0.05), var(--shadow);
    animation: hero-float 5.5s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.9s);
  }

  .tiles li:nth-child(odd) .tile {
    scale: 0.8;
    opacity: 0.88;
    filter: blur(0.7px);
  }

  .tiles li:nth-child(even) .tile {
    color: var(--green-2);
  }

  @keyframes hero-float {
    from {
      transform: translateY(-7px) rotate(-3deg);
    }

    to {
      transform: translateY(7px) rotate(3deg);
    }
  }

  /* Draw-in strokes: with no JS or reduced motion, offset 0 = the whole icon. */
  :global(.js) .tile :global(svg > *) {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: hero-draw 0.9s ease-out both;
    animation-delay: calc(1.45s + var(--i) * 0.08s);
  }

  @keyframes hero-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* ----- Load sequence ----- */
  .line,
  .text p {
    animation: hero-rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .big {
    animation-delay: 0.12s;
  }

  .text p {
    animation-delay: 0.3s;
  }

  .rings {
    animation: hero-grow 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.35s both;
  }

  .phone {
    animation: hero-phone 1.1s cubic-bezier(0.2, 0.9, 0.25, 1) 0.55s both;
  }

  .tiles li {
    animation: hero-burst 0.8s cubic-bezier(0.25, 1.4, 0.5, 1) both;
    animation-delay: calc(1.1s + var(--i) * 0.08s);
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 28px;
    }
  }

  @keyframes hero-grow {
    from {
      scale: 0.75 0.6;
    }
  }

  @keyframes hero-phone {
    from {
      opacity: 0;
      transform: translateY(180px);
    }
  }

  /* Tiles start inside the rings, behind them, and fly out to their place on the orbit. */
  @keyframes hero-burst {
    from {
      opacity: 0;
      transform: rotate(var(--a)) translateY(calc(-1 * var(--r) + 160px)) rotate(calc(var(--a) * -0.6)) scale(0.3);
    }
  }

  .next {
    position: absolute;
    inset-block-end: -32px;
    left: 50%;
    translate: -50% 0;
    z-index: 3;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    border-radius: 50%;
    background: var(--blue-grad);
    color: var(--white);
    box-shadow: var(--shadow-strong);
  }

  .next :global(svg) {
    animation: hero-nudge 1.8s ease-in-out 2.6s infinite;
  }

  @keyframes hero-nudge {
    0%,
    60%,
    100% {
      transform: translateY(0);
    }

    30% {
      transform: translateY(5px);
    }
  }

  @media (max-width: 700px) {
    .stage {
      --ring-w: 150vw;
      block-size: 400px;
    }

    /* No room beside the phone on a narrow screen. */
    .tiles {
      display: none;
    }
  }
</style>
