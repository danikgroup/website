---
// Before/after table: what a task costs today, and the same task with the product.
// rows=[{topic, before, after}]. Under 760px each row becomes a card.
import Icon from "./Icon.astro";

const { rows = [], before = "امروز", after = "با نرم‌افزار", caption } = Astro.props;
---
<table class="compare">
  {caption && <caption class="visually-hidden">{caption}</caption>}
  <thead>
    <tr>
      <td></td>
      <th scope="col">{before}</th>
      <th scope="col" class="after">{after}</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <th scope="row">{r.topic}</th>
        <td><span class="mark no"><Icon name="close" size={16} strokeWidth={2.4} /></span>{r.before}</td>
        <td class="after"><span class="mark yes"><Icon name="check" size={16} strokeWidth={2.6} /></span>{r.after}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  /* The "after" column is one raised white strip: cells share a background and only the first
     and last round their corners, so it reads as a single card lifted off the grey. */
  .compare {
    inline-size: 100%;
    border-collapse: separate;
    border-spacing: 0;
    text-align: start;
  }

  th,
  td {
    padding: 22px 24px;
    vertical-align: top;
    text-align: start;
  }

  thead th {
    padding-block: 14px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 700;
  }

  thead th.after {
    padding-block-start: 22px;
    border-start-start-radius: 24px;
    border-start-end-radius: 24px;
    color: #0b8a62;
  }

  tbody th {
    inline-size: 9rem;
    color: var(--navy);
    font-size: 1.05rem;
  }

  tbody td {
    border-block-start: 1px solid var(--line);
  }

  td:not(.after) {
    color: var(--muted);
  }

  .after {
    background: var(--white);
    color: var(--navy);
    box-shadow:
      inset 1px 0 0 var(--line),
      inset -1px 0 0 var(--line);
  }

  tbody tr:last-child .after {
    border-end-start-radius: 24px;
    border-end-end-radius: 24px;
    box-shadow:
      inset 1px 0 0 var(--line),
      inset -1px 0 0 var(--line),
      inset 0 -1px 0 var(--line);
  }

  thead .after {
    box-shadow:
      inset 1px 0 0 var(--line),
      inset -1px 0 0 var(--line),
      inset 0 1px 0 var(--line);
  }

  .mark {
    display: inline-grid;
    place-items: center;
    inline-size: 24px;
    block-size: 24px;
    margin-inline-end: 10px;
    border-radius: 50%;
    vertical-align: -6px;
  }

  .no {
    background: #eceaf3;
    color: var(--muted);
  }

  .yes {
    background: var(--green-grad);
    color: var(--navy);
  }

  @media (max-width: 760px) {
    thead {
      display: none;
    }

    .compare,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    tbody {
      display: grid;
      gap: 16px;
    }

    tbody tr {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--grey);
    }

    tbody th {
      inline-size: auto;
      padding-block-end: 4px;
    }

    tbody td {
      border: 0;
      padding-block: 8px 16px;
    }

    .after,
    tbody tr:last-child .after {
      border-radius: 0;
      box-shadow: inset 0 1px 0 var(--line);
      padding-block: 16px 20px;
    }
  }
</style>
