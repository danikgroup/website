---
// Questions as native <details>; the page adds the FAQPage JSON-LD (faqLd in utils.js).
const { items = [], title = "پرسش‌های پرتکرار", id = "faq" } = Astro.props;
---
{items.length > 0 && (
  <section class="section" aria-labelledby={id}>
    <div class="wrap faq">
      <div class="intro"><h2 id={id}>{title}</h2></div>
      {items.map((f) => (
        <details>
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}

<style>
  .faq {
    max-inline-size: 760px;
  }

  details {
    border-block-end: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
    color: var(--navy);
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Plus that turns into a minus when open. */
  summary::after {
    content: "+";
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 50%;
    background: var(--blue-grad);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25), var(--shadow-strong);
    color: var(--white);
    font-size: 1.3rem;
    transition: rotate 0.25s;
  }

  details[open] summary::after {
    content: "−";
    rotate: 180deg;
  }

  details p {
    padding-block-end: 20px;
  }
</style>
